{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "pm_app",
      "request": "launch",
      "type": "dart",
      "cwd": "pm_app",
      "program": "lib/main.dart"
    },
    {
      "name": "pm_app (Chrome)",
      "request": "launch",
      "type": "dart",
      "cwd": "pm_app",
      "program": "lib/main.dart",
      "deviceId": "chrome"
    },
    {
      "name": "pm_app (Web Server 5111)",
      "request": "launch",
      "type": "dart",
      "cwd": "pm_app",
      "program": "lib/main.dart",
      "deviceId": "web-server",
      "toolArgs": [
        "--web-hostname",
        "127.0.0.1",
        "--web-port",
        "5111"
      ]
    }
  ]
}
